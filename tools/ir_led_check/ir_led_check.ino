// ---------------------------------------------------------------------------
//  ir_led_check.ino  —  赤外線LEDが光っているかを確かめるだけのスケッチ
//
//  赤外線は肉眼では見えない。スマホの「インカメラ」越しに見ると
//  薄紫色に光って見える。（背面カメラは赤外線カットフィルタが強く見えにくい）
//
//  配線ミスやトランジスタの向き違いを切り分けるときに最初に使う。
// ---------------------------------------------------------------------------

const int kIrLedPin = 4;   // D4

void setup() {
  pinMode(kIrLedPin, OUTPUT);
  digitalWrite(kIrLedPin, HIGH);   // 点きっぱなしにする
}

void loop() {}
